#!/bin/bash
set -euo pipefail
export PATH=/usr/bin:/bin
plugin_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
[[ $# == 2 ]] || { printf 'Usage: apple-tv <IPv4 address> <command>\n' >&2; exit 2; }
limit=25
[[ "$2" == keyboard_watch ]] && limit=3600
exec /usr/bin/python -E -s -B "$plugin_dir/bin/runner.py" "$limit" /usr/bin/python -E -s -B "$plugin_dir/bin/runtime.py" remote "$1" "$2" "$plugin_dir/bin/remote_daemon.py"
