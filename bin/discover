#!/usr/bin/env bash
set -euo pipefail

data_home="${XDG_DATA_HOME:-$HOME/.local/share}"
python="$data_home/omarchy/apple-tv-remote/venv/bin/python"
plugin_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"

if [[ ! -x "$python" ]]; then
  printf '{"error":"Setup required","devices":[]}\n'
  exit 127
fi

exec "$python" "$plugin_dir/bin/discovery.py"
