#!/bin/bash
set -euo pipefail
export PATH=/usr/bin:/bin
plugin_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
# Installation is shared with in-panel pairing and verifies the complete lock.
/usr/bin/python -E -s -B "$plugin_dir/bin/runner.py" 330 /usr/bin/python -E -s -B "$plugin_dir/bin/runtime.py" install
printf 'Installation complete. Open Apple TV Remote and choose Manage Apple TV to pair.\n'
