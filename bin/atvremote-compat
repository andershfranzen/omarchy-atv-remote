#!/usr/bin/env bash
set -euo pipefail

data_home="${XDG_DATA_HOME:-$HOME/.local/share}"
python="$data_home/omarchy/apple-tv-remote/venv/bin/python"

exec "$python" -c '
import asyncio
import sys
asyncio.set_event_loop(asyncio.new_event_loop())
from pyatv.scripts.atvremote import main
sys.exit(main())
' "$@"
